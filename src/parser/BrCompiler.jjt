}

TOKEN: /*operacoes*/
{
 <SOMA : "+">|
 <SUBTRACAO : "-">|
 <MULTIPLICACAO : "*">|
 <DIVISAO : "/">|
 <OPMAIOR: ">">|
 <OPIGUAL: "==">|
 <OPMENOR: "<">|
 <OPDIF: "!=">|
 <OPMAIORIGUAL: " >=" >|
 <OPMENORIGUAL: "<=" >|
 <OPAND: "&&" >|
 <OPOR: "|" >
}

void main() :
{ RecoverySet g = Follow.main; }
{
  try { 
    <INICIOPROG> <ABREBLOCO> bloco() <FECHABLOCO>
  } catch(ParseException e) {
    consumeUntil(g, e, "main");
  }
}

void bloco():
{ RecoverySet g = Follow.bloco; }
{
    (
      try {
        (comando() | declaraFuncao())
      } catch (ParseException e) {
        consumeUntil(g, e, "bloco");
      }
    )*
}

void comando():
{ RecoverySet g = Follow.comando; }
{
   try {
       declaraVariavel() 			|
       expressaoCondicional()       |
       comandoIdentificador()       |
       print()					    |
       scan()					    |
       whileLoop()				    |
       forLoop()				    |
       retorno()
   } catch (ParseException e) {
       consumeUntil(g, e, "comando");
   }
}

void comandoIdentificador():
{ RecoverySet g = Follow.comandoIdentificador; }
{
  try {
      <IDENTIFICADOR> comandoIdentificadorSufixo()
  } catch (ParseException e) {
      consumeUntil(g, e, "comandoIdentificador");
  }
}

void comandoIdentificadorSufixo():
{ RecoverySet g = Follow.comandoIdentificadorSufixo; }
{
  try {
      <ATRIBUICAO> Expressao() <FIMESTRUTURA>                                    |
      <ABRIRFUNC> (ListaExpressoes())? <FECHARFUNC> <FIMESTRUTURA>               |
      <ADICIONAR> Expressao() <FIMESTRUTURA>                                     |
      <REMOVER> <ABRIREXP> Expressao() <FECHAREXP> <FIMESTRUTURA>                |
      <EMPILHAR> Expressao() <FIMESTRUTURA>                                      |
      <DESEMPILHAR> <FIMESTRUTURA>                                               |
      (<ABRIREXP> (ListaExpressoes())? <FECHAREXP>)? sufixoExpressao()
  } catch (ParseException e) {
      consumeUntil(g, e, "comandoIdentificadorSufixo");
  }
}

void sufixoExpressao():
{ RecoverySet g = Follow.sufixoExpressao; }
{
  try {
      ((<SOMA> | <SUBTRACAO>) fator())* <FIMESTRUTURA>
  } catch (ParseException e) {
      consumeUntil(g, e, "sufixoExpressao");
  }
}

void declaraVariavel():
{ RecoverySet g = Follow.declaraVariavel; }
{
    try {
        tipoDado()
        ListaIdentificadores()
        (
            <ATRIBUICAO> ListaExpressoes()
        )?
        <FIMESTRUTURA>
    } catch (ParseException e) {
        consumeUntil(g, e, "declaraVariavel");
    }
}

void tipoDado():
{ RecoverySet g = Follow.tipoDado; }
{
    try {
        (<INT> | <FLOAT>| <STRING> | <BOOL> | tipoLista() | tipoPilha())
    } catch (ParseException e) {
        consumeUntil(g, e, "tipoDado");
    }
}

void ListaIdentificadores():
{ RecoverySet g = Follow.listaIdentificadores; }
{
    try {
        <IDENTIFICADOR> (<VIRGULA> <IDENTIFICADOR>)*
    } catch (ParseException e) {
        consumeUntil(g, e, "ListaIdentificadores");
    }
}

void ListaExpressoes():
{ RecoverySet g = Follow.listaExpressoes; }
{
    try {
        Expressao()
        (
            <VIRGULA> Expressao()
        )*
    } catch (ParseException e) {
        consumeUntil(g, e, "ListaExpressoes");
    }
}

void Expressao():
{ RecoverySet g = Follow.expressao; }
{
    try {
        fator()
        (
            (<SOMA> | <SUBTRACAO>)
            fator()
        )*
    } catch (ParseException e) {
        consumeUntil(g, e, "Expressao");
    }
}

void fator(): 
{ RecoverySet g = Follow.fator; }
{
   try {
       termo()
       (
         (<MULTIPLICACAO> | <DIVISAO>)
         termo()
       )*
   } catch (ParseException e) {
       consumeUntil(g, e, "fator");
   }
}

void termo(): 
{ RecoverySet g = Follow.termo; }
{
  try {
      <IDENTIFICADOR> termoIdentificadorSufixo()                    |
      <CONSTANTE_INT>                                               |
      <CONSTANTE_FLOAT>                                             |
      <LITERAL_STRING>                                              |
      <TRUE>                                                        |
      <FALSE>                                                       |
      <TAMANHO> <IDENTIFICADOR>                                     |  
      inicializacaoLista()                                          |
      <TOPO> <IDENTIFICADOR>                                        |
      <PILHA_VAZIA> <IDENTIFICADOR>                                 |
      "(" Expressao() ")"
  } catch (ParseException e) {
      consumeUntil(g, e, "termo");
  }
}

void termoIdentificadorSufixo():
{ RecoverySet g = Follow.termoIdentificadorSufixo; }
{
  try {
      <ABRIRFUNC> (ListaExpressoes())? <FECHARFUNC>               |
      (<ABRIREXP> (ListaExpressoes())? <FECHAREXP>)?
  } catch (ParseException e) {
      consumeUntil(g, e, "termoIdentificadorSufixo");
  }
}

void operadorLogico():
{ RecoverySet g = Follow.expressao; }
{
  try {
      (<OPDIF> | <OPIGUAL> | <OPMAIOR> | <OPMENOR> | <OPMAIORIGUAL> | <OPMENORIGUAL> | <OPAND> | <OPOR>)
  } catch (ParseException e) {
      consumeUntil(g, e, "operadorLogico");
  }
}

void expressaoLogica():
{ RecoverySet g = Follow.expressao; }
{
  try {
      Expressao() operadorLogico() Expressao()
  } catch (ParseException e) {
      consumeUntil(g, e, "expressaoLogica");
  }
}

void expressaoCondicional():
{ RecoverySet g = Follow.expressaoCondicional; }
{
  try {
      condicao() (<SENAO> (
            condicao() |
          <ABREBLOCO> bloco() <FECHABLOCO>)
          )?
  } catch (ParseException e) {
      consumeUntil(g, e, "expressaoCondicional");
  }
}

void condicao():
{ RecoverySet g = Follow.condicao; }
{
  try {
      <CONDICIONAL> <ABRIREXP> expressaoLogica() <FECHAREXP> <ABREBLOCO> bloco() <FECHABLOCO>
  } catch (ParseException e) {
      consumeUntil(g, e, "condicao");
  }
}

void print():
{ RecoverySet g = Follow.print; }
{
    try {
        <PRINT> ListaExpressoes() <FIMESTRUTURA>  
    } catch (ParseException e) {
        consumeUntil(g, e, "print");
    }
}

void scan():
{ RecoverySet g = Follow.scan; }
{
   try {
       <SCAN> <IDENTIFICADOR> <FIMESTRUTURA>
   } catch (ParseException e) {
       consumeUntil(g, e, "scan");
   }
}

void whileLoop():
{ RecoverySet g = Follow.whileLoop; }
{
    try {
        <WHILE> <ABRIREXP > expressaoLogica() <FECHAREXP>
             <ABREBLOCO> bloco() <FECHABLOCO>
    } catch (ParseException e) {
        consumeUntil(g, e, "whileLoop");
    }
}

void forLoop():
{ RecoverySet g = Follow.forLoop; }
{
  try {
      <FOR> <ABRIREXP>
            atribuicaoFor() <SEPARADOR>
            expressaoLogica() <SEPARADOR>
            atribuicaoFor()
             <FECHAREXP>
             <ABREBLOCO>
                bloco()
             <FECHABLOCO>
  } catch (ParseException e) {
      consumeUntil(g, e, "forLoop");
  }
}

void atribuicaoFor():
{ RecoverySet g = Follow.atribuicaoFor; }
{
  try {
      (tipoDado())? <IDENTIFICADOR> <ATRIBUICAO> Expressao()
  } catch (ParseException e) {
      consumeUntil(g, e, "atribuicaoFor");
  }
}

void declaraFuncao():
{ RecoverySet g = Follow.declaraFuncao; }
{
 try {
     <FUNCAO> (tipoDado())? <IDENTIFICADOR> <ABRIRFUNC> (listaParametros())? <FECHARFUNC>
        <ABREBLOCO> bloco() <FECHABLOCO>
 } catch (ParseException e) {
     consumeUntil(g, e, "declaraFuncao");
 }
}

void listaParametros():
{ RecoverySet g = Follow.listaParametros; }
{
  try {
      parametro() (<VIRGULA> parametro())*
  } catch (ParseException e) {
      consumeUntil(g, e, "listaParametros");
  }
}

void parametro():
{ RecoverySet g = Follow.parametro; }
{
  try {
      tipoDado() <IDENTIFICADOR>
  } catch (ParseException e) {
      consumeUntil(g, e, "parametro");
  }
}

void retorno():
{ RecoverySet g = Follow.retorno; }
{
    try {
        <RETURN> (Expressao())?<FIMESTRUTURA>
    } catch (ParseException e) {
        consumeUntil(g, e, "retorno");
    }
}

void tipoLista():
{ RecoverySet g = Follow.tipoLista; }
{
  try {
      <LISTA> (<INT> | <FLOAT> | <STRING> | <BOOL>)
  } catch (ParseException e) {
      consumeUntil(g, e, "tipoLista");
  }
}

void inicializacaoLista():
{ RecoverySet g = Follow.inicializacaoLista; }
{
  try {
      <ABRIREXP> (ListaExpressoes())? <FECHAREXP>
  } catch (ParseException e) {
      consumeUntil(g, e, "inicializacaoLista");
  }
}

