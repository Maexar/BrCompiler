  SimpleNode jjtn000 = new SimpleNode(JJTOPERADORLOGICO);
  boolean jjtc000 = true;
  jjtree.openNodeScope(jjtn000);
/*@egen*/ RecoverySet g = Follow.expressao; /* Usa o mesmo de express\u00e3o pois conecta express\u00f5es */ }
{/*@bgen(jjtree) operadorLogico */
  try {
/*@egen*/
  try {
      (<OPDIF> | <OPIGUAL> | <OPMAIOR> | <OPMENOR> | <OPMAIORIGUAL> | <OPMENORIGUAL> | <OPAND> | <OPOR>)
